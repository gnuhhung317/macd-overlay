//@version=5
indicator("MACD Overlay (Standard)", overlay=true, precision=2)

// MACD Parameters
fastLength = input.int(12, title="Fast Length")
slowLength = input.int(26, title="Slow Length")
signalLength = input.int(9, title="Signal Length")

// Calculate MACD (Standard Formula)
fastEMA = ta.ema(close, fastLength)
slowEMA = ta.ema(close, slowLength)
macdLine = fastEMA - slowEMA

// Signal Line (SMA of MACD)
signalLine = ta.sma(macdLine, signalLength)

// Histogram
histogram = macdLine - signalLine

// Plot MACD Line
macdColor = macdLine > macdLine[1] ? color.green : macdLine < macdLine[1] ? color.red : color.black
plot(macdLine, color=macdColor, linewidth=2, title="MACD Line")

// Plot Signal Line
signalColor = signalLine > signalLine[1] ? color.green : signalLine < signalLine[1] ? color.red : color.black
plot(signalLine, color=signalColor, linewidth=2, title="Signal Line")

// Fill between MACD and Signal
fillColor = macdLine > signalLine ? color.new(color.green, 50) : color.new(color.red, 50)
fill(plot(macdLine), plot(signalLine), color=fillColor, title="MACD Fill")

// Optional: Add SMA
smaLength = input.int(89, title="SMA Length")
smaLine = ta.sma(close, smaLength)
smaColor = smaLine > smaLine[1] ? color.green : smaLine < smaLine[1] ? color.red : color.black
plot(smaLine, color=smaColor, linewidth=2, title="SMA")

// Alert conditions for crossovers
bullishCross = ta.crossover(macdLine, signalLine)
bearishCross = ta.crossunder(macdLine, signalLine)

// Plot crossover markers
plotshape(bullishCross, title="Bullish Cross", location=location.belowbar, 
          color=color.green, style=shape.triangleup, size=size.small)
plotshape(bearishCross, title="Bearish Cross", location=location.abovebar, 
          color=color.red, style=shape.triangledown, size=size.small)

// Alerts
alertcondition(bullishCross, title="MACD Bullish Cross", message="MACD crossed above Signal - BUY signal")
alertcondition(bearishCross, title="MACD Bearish Cross", message="MACD crossed below Signal - SELL signal")
